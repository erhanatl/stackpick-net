---
interface Props {
  name: string;
  slug: string;
  category: string;
  shortDescription: string;
  vendor: string;
  pricingModel: string;
  startingPrice: string;
  websiteUrl?: string;
}

const { name, slug, category, shortDescription, vendor, pricingModel, startingPrice, websiteUrl } = Astro.props;

const getDomain = (url: string | undefined) => {
  if (!url) return null;
  try { return new URL(url).hostname; } catch { return null; }
};
const domain = getDomain(websiteUrl);
const logoUrl = domain ? `https://www.google.com/s2/favicons?domain=${domain}&sz=64` : null;

const categoryConfig: Record<string, { badge: string; dot: string }> = {
  'CI/CD':          { badge: 'bg-blue-50 text-blue-700 border-blue-100',       dot: 'bg-blue-400' },
  'Code Assistant': { badge: 'bg-violet-50 text-violet-700 border-violet-100', dot: 'bg-violet-400' },
  'Monitoring':     { badge: 'bg-emerald-50 text-emerald-700 border-emerald-100', dot: 'bg-emerald-400' },
  'Testing':        { badge: 'bg-orange-50 text-orange-700 border-orange-100', dot: 'bg-orange-400' },
  'Security':       { badge: 'bg-red-50 text-red-700 border-red-100',           dot: 'bg-red-400' },
  'IaC':            { badge: 'bg-cyan-50 text-cyan-700 border-cyan-100',         dot: 'bg-cyan-400' },
  'AI Code Review': { badge: 'bg-indigo-50 text-indigo-700 border-indigo-100', dot: 'bg-indigo-400' },
  'AIOps':          { badge: 'bg-amber-50 text-amber-700 border-amber-100',     dot: 'bg-amber-400' },
};

const cfg = categoryConfig[category] || { badge: 'bg-gray-50 text-gray-700 border-gray-100', dot: 'bg-gray-400' };
---

<a href={`/tools/${slug}/`} class="card-hover block bg-white rounded-xl border border-border p-6 group relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-primary to-accent opacity-0 group-hover:opacity-100 transition-opacity"></div>

  <div class="flex items-start justify-between mb-3">
    <div class="flex items-center gap-3">
      {logoUrl ? (
        <img src={logoUrl} alt={`${name} logo`} width="32" height="32" class="rounded-lg shrink-0 border border-gray-100" loading="lazy" />
      ) : (
        <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
          <span class="text-sm font-bold text-primary">{name.charAt(0)}</span>
        </div>
      )}
      <div>
        <h3 class="text-base font-semibold group-hover:text-primary transition-colors leading-tight">{name}</h3>
        <p class="text-xs text-text-muted">{vendor}</p>
      </div>
    </div>
    <span class={`text-xs font-medium px-2 py-0.5 rounded-full border ${cfg.badge} shrink-0 ml-2 flex items-center gap-1`}>
      <span class={`w-1.5 h-1.5 rounded-full ${cfg.dot}`}></span>
      {category}
    </span>
  </div>
  <p class="text-sm text-gray-500 mb-4 line-clamp-2 leading-relaxed">{shortDescription}</p>
  <div class="flex items-center justify-between text-sm">
    <div>
      <span class="font-semibold text-text">{startingPrice}</span>
      <span class="text-text-muted"> · {pricingModel}</span>
    </div>
    <span class="text-primary opacity-0 group-hover:opacity-100 transition-opacity text-xs font-medium">View →</span>
  </div>
</a>
