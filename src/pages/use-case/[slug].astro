---
import BaseLayout from '../../layouts/BaseLayout.astro';
import useCases from '../../data/use-cases.json';
import tools from '../../data/tools.json';
import comparisons from '../../data/comparisons.json';
import guides from '../../data/guides.json';

export function getStaticPaths() {
  return useCases.map((uc) => ({
    params: { slug: uc.slug },
    props: { uc },
  }));
}

const { uc } = Astro.props;

const accentClasses: Record<string, { bg: string; text: string; border: string; pill: string; dot: string; ring: string; gradient: string }> = {
  amber:   { bg: 'bg-amber-50',   text: 'text-amber-700',   border: 'border-l-amber-400',   pill: 'bg-amber-50 text-amber-700 border-amber-100',     dot: 'bg-amber-400',   ring: 'hover:border-amber-300',   gradient: 'from-amber-50 to-orange-50' },
  red:     { bg: 'bg-red-50',     text: 'text-red-700',     border: 'border-l-red-400',     pill: 'bg-red-50 text-red-700 border-red-100',           dot: 'bg-red-400',     ring: 'hover:border-red-300',     gradient: 'from-red-50 to-orange-50' },
  violet:  { bg: 'bg-violet-50',  text: 'text-violet-700',  border: 'border-l-violet-400',  pill: 'bg-violet-50 text-violet-700 border-violet-100',  dot: 'bg-violet-400',  ring: 'hover:border-violet-300',  gradient: 'from-violet-50 to-purple-50' },
  blue:    { bg: 'bg-blue-50',    text: 'text-blue-700',    border: 'border-l-blue-400',    pill: 'bg-blue-50 text-blue-700 border-blue-100',        dot: 'bg-blue-400',    ring: 'hover:border-blue-300',    gradient: 'from-blue-50 to-cyan-50' },
  emerald: { bg: 'bg-emerald-50', text: 'text-emerald-700', border: 'border-l-emerald-400', pill: 'bg-emerald-50 text-emerald-700 border-emerald-100', dot: 'bg-emerald-400', ring: 'hover:border-emerald-300', gradient: 'from-emerald-50 to-teal-50' },
};
const cfg = accentClasses[uc.accentColor] || accentClasses.violet;

// Resolve tool data for top tools and stages
const topToolsResolved = uc.topTools.map((t) => {
  const tool = tools.find((x) => x.slug === t.slug);
  return { ...t, tool };
}).filter((t) => t.tool);

const stagesResolved = uc.stages.map((stage) => ({
  ...stage,
  toolsResolved: stage.tools
    .map((s) => tools.find((x) => x.slug === s))
    .filter(Boolean),
}));

const relatedComparisonsResolved = uc.relatedComparisons
  .map((s) => comparisons.find((c) => c.slug === s))
  .filter(Boolean);

const relatedGuidesResolved = uc.relatedGuides
  .map((s) => guides.find((g) => g.slug === s))
  .filter(Boolean);

const siteUrl = 'https://stackpick.net';
const canonicalUrl = `${siteUrl}/use-case/${uc.slug}/`;
---

<BaseLayout
  title={uc.metaTitle || uc.title}
  description={uc.metaDescription || uc.description}
  canonical={canonicalUrl}
>
  <article class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumb -->
      <nav class="text-sm text-text-muted mb-8">
        <a href="/" class="hover:text-primary">Home</a>
        <span class="mx-2">/</span>
        <a href="/use-case/" class="hover:text-primary">Use Cases</a>
        <span class="mx-2">/</span>
        <span class="text-text">{uc.title}</span>
      </nav>

      <!-- Hero -->
      <header class={`relative rounded-2xl bg-gradient-to-br ${cfg.gradient} p-8 mb-10 overflow-hidden`}>
        <div class="relative z-10">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-4xl">{uc.icon}</span>
            <span class={`text-xs font-medium px-2.5 py-1 rounded-full border flex items-center gap-1.5 ${cfg.pill}`}>
              <span class={`w-1.5 h-1.5 rounded-full ${cfg.dot}`}></span>
              Use Case
            </span>
          </div>
          <h1 class="text-4xl font-bold mb-3 leading-tight">{uc.title}</h1>
          <p class={`text-lg font-medium ${cfg.text} mb-4`}>{uc.headline}</p>
          <p class="text-base text-text-muted max-w-3xl">{uc.description}</p>
        </div>
      </header>

      <!-- The Problem -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4">The Problem</h2>
        <p class="text-base text-text leading-relaxed">{uc.problem}</p>
      </section>

      <!-- The Stack (Stages) -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-6">The Stack</h2>
        <div class="space-y-6">
          {stagesResolved.map((stage, idx) => (
            <div class={`cat-card bg-white border border-border rounded-xl p-6 ${cfg.border}`}>
              <div class="flex items-baseline gap-3 mb-2">
                <span class={`text-xs font-bold ${cfg.text} mono`}>STAGE {idx + 1}</span>
                <h3 class="text-xl font-bold">{stage.name}</h3>
              </div>
              <p class="text-text-muted mb-4">{stage.description}</p>
              <div class="grid sm:grid-cols-2 gap-3">
                {stage.toolsResolved.map((t) => {
                  const domain = t.website_url ? (() => { try { return new URL(t.website_url).hostname; } catch { return ''; } })() : '';
                  return (
                    <a
                      href={`/tools/${t.slug}/`}
                      class={`flex items-center gap-3 bg-surface border border-border rounded-lg p-3 transition-all ${cfg.ring}`}
                    >
                      {domain && <img src={`https://www.google.com/s2/favicons?domain=${domain}&sz=32`} alt="" class="w-5 h-5 rounded shrink-0" loading="lazy" />}
                      <div class="min-w-0">
                        <p class="font-medium text-sm truncate">{t.tool_name}</p>
                        <p class="text-xs text-text-muted truncate">{t.starting_price}</p>
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Top Picks -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-6">Top Picks</h2>
        <div class="space-y-4">
          {topToolsResolved.map(({ reason, tool }, idx) => {
            const domain = tool.website_url ? (() => { try { return new URL(tool.website_url).hostname; } catch { return ''; } })() : '';
            return (
              <div class={`cat-card bg-white border border-border rounded-xl p-6 ${cfg.border}`}>
                <div class="flex items-start gap-4">
                  <div class={`flex-shrink-0 w-10 h-10 rounded-full ${cfg.bg} ${cfg.text} flex items-center justify-center font-bold mono`}>
                    {idx + 1}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-3 mb-2 flex-wrap">
                      {domain && <img src={`https://www.google.com/s2/favicons?domain=${domain}&sz=32`} alt="" class="w-6 h-6 rounded" />}
                      <a href={`/tools/${tool.slug}/`} class="text-xl font-bold hover:text-primary transition-colors">{tool.tool_name}</a>
                      <span class="text-sm text-text-muted">by {tool.vendor}</span>
                    </div>
                    <p class="text-text-muted mb-3">{reason}</p>
                    <div class="flex flex-wrap gap-2 text-sm">
                      <span class="bg-surface px-3 py-1 rounded-full">{tool.pricing_model}</span>
                      <span class="bg-surface px-3 py-1 rounded-full">{tool.starting_price}</span>
                      <a href={`/tools/${tool.slug}/`} class="text-primary hover:underline">Review →</a>
                      <a href={`/pricing/${tool.slug}/`} class="text-primary hover:underline">Pricing →</a>
                      <a href={`/alternatives/${tool.slug}/`} class="text-primary hover:underline">Alternatives →</a>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Related Comparisons -->
      {relatedComparisonsResolved.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">Compare These Tools</h2>
          <div class="grid gap-3">
            {relatedComparisonsResolved.map((comp) => (
              <a href={`/compare/${comp.slug}/`} class="flex items-center justify-between bg-white border border-border rounded-xl p-5 hover:shadow-md transition-shadow group">
                <div>
                  <p class="font-semibold group-hover:text-primary transition-colors">{comp.title}</p>
                  <p class="text-sm text-text-muted mt-1">{comp.description}</p>
                </div>
                <span class="text-primary text-sm font-medium shrink-0 ml-4">Compare →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Related Guides -->
      {relatedGuidesResolved.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6">Read More</h2>
          <div class="grid gap-3">
            {relatedGuidesResolved.map((g) => (
              <a href={`/blog/${g.slug}/`} class="flex items-center justify-between bg-white border border-border rounded-xl p-5 hover:shadow-md transition-shadow group">
                <div>
                  <p class="font-semibold group-hover:text-primary transition-colors">{g.title}</p>
                  <p class="text-sm text-text-muted mt-1 line-clamp-2">{g.description}</p>
                </div>
                <span class="text-primary text-sm font-medium shrink-0 ml-4">Read →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- JSON-LD: BreadcrumbList -->
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
          { "@type": "ListItem", "position": 2, "name": "Use Cases", "item": `${siteUrl}/use-case/` },
          { "@type": "ListItem", "position": 3, "name": uc.title }
        ]
      })} />

      <!-- JSON-LD: HowTo (stages map to steps) -->
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "HowTo",
        "name": uc.title,
        "description": uc.description,
        "step": stagesResolved.map((stage, idx) => ({
          "@type": "HowToStep",
          "position": idx + 1,
          "name": stage.name,
          "text": stage.description
        }))
      })} />

    </div>
  </article>
</BaseLayout>
