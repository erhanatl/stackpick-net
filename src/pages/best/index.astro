---
import { categoryIcon } from '../../lib/categories';
import BaseLayout from '../../layouts/BaseLayout.astro';
import hubPages from '../../data/hub-pages.json';

---

<BaseLayout
  title="Best AI DevOps Tools by Category 2026"
  description="Curated lists of the best AI-powered DevOps tools in every category. Expert picks with rankings, buyer's guides, and side-by-side comparisons."
>
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-text-muted mb-8">
        <a href="/" class="hover:text-primary">Home</a>
        <span class="mx-2">/</span>
        <span class="text-text">Best Tools</span>
      </nav>

      <h1 class="text-4xl font-bold mb-4">Best AI DevOps Tools by Category</h1>
      <p class="text-lg text-text-muted mb-12">Expert-curated rankings of the top AI tools in every DevOps category, with buyer's guides and head-to-head comparisons.</p>

      <div class="grid gap-4">
        {hubPages.map(hub => {
          return (
            <a href={`/best/${hub.slug}/`} class="cat-card bg-white border border-border rounded-xl p-6 hover:shadow-md hover:border-primary/40 transition-all group">
              <div class="flex items-start justify-between">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-3">
                    <span class="text-text-muted [&>svg]:w-4 [&>svg]:h-4" set:html={categoryIcon(hub.category)} />
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full border border-border bg-gray-50 text-text-muted">
                      {hub.category}
                    </span>
                  </div>
                  <h2 class="text-xl font-bold group-hover:text-primary transition-colors mb-2">{hub.title}</h2>
                  <p class="text-text-muted text-sm">{hub.description}</p>
                </div>
                <span class="text-primary font-medium shrink-0 ml-6 opacity-60 group-hover:opacity-100 transition-opacity">View picks →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
