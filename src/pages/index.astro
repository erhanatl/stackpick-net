---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import tools from '../data/tools.json';
import categories from '../data/categories.json';
import guides from '../data/guides.json';

const publishedTools = tools.filter(t => t.status === 'Published');
const comparisons = (await import('../data/comparisons.json')).default;
const latestGuides = [...guides]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);
// "Recently Added" — last entries in tools.json represent most recent additions.
// We take 6 to fill a 3-column grid on 2 rows.
const recentlyAddedTools = [...publishedTools].slice(-6).reverse();

const categoryConfig: Record<string, { color: string; border: string; icon: string }> = {
  'CI/CD':          { color: 'bg-blue-50 text-blue-700',      border: 'border-l-blue-400',   icon: '⚙️' },
  'Code Assistant': { color: 'bg-violet-50 text-violet-700',  border: 'border-l-violet-400', icon: '🤖' },
  'Monitoring':     { color: 'bg-emerald-50 text-emerald-700',border: 'border-l-emerald-400',icon: '📡' },
  'Testing':        { color: 'bg-orange-50 text-orange-700',  border: 'border-l-orange-400', icon: '🧪' },
  'Security':       { color: 'bg-red-50 text-red-700',        border: 'border-l-red-400',    icon: '🛡️' },
  'IaC':            { color: 'bg-cyan-50 text-cyan-700',      border: 'border-l-cyan-400',   icon: '🏗️' },
  'AI Code Review': { color: 'bg-indigo-50 text-indigo-700',  border: 'border-l-indigo-400', icon: '🔍' },
  'AIOps':          { color: 'bg-amber-50 text-amber-700',    border: 'border-l-amber-400',  icon: '⚡' },
};

function estimateReadingTime(content: string): number {
  const words = content.split(/\s+/).length;
  return Math.ceil(words / 200);
}
---

<BaseLayout
  title="Home"
  description="Compare the best AI tools for DevOps. Unbiased reviews, side-by-side comparisons, and expert picks for CI/CD, monitoring, security, and more."
>
  <!-- Hero Section -->
  <section class="hero-gradient text-white py-12 md:py-24 relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-40"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-violet-600/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-cyan-500/15 rounded-full blur-3xl translate-y-1/2 -translate-x-1/3"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative">
      <div class="animate-fade-up">
        <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-xs font-medium text-cyan-300 px-3 py-1.5 rounded-full mb-6 backdrop-blur-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
          <span class="mono">{publishedTools.length} AI DevOps tools reviewed</span>
        </div>

        <h1 class="text-4xl md:text-6xl font-bold mb-6 tracking-tight leading-tight">
          Find the Right AI Tools<br />
          <span class="bg-gradient-to-r from-violet-300 via-cyan-300 to-violet-300 bg-clip-text text-transparent">for Your DevOps Stack</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-10 leading-relaxed">
          Independent, unsponsored comparisons. No affiliate rankings. Just honest picks to help your team cut through the noise.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/tools/" class="bg-primary hover:bg-primary-dark text-white px-8 py-3.5 rounded-xl font-semibold transition-all hover:shadow-lg hover:shadow-primary/30 hover:-translate-y-0.5">
            Browse All Tools
          </a>
          <a href="/compare/" class="bg-white/10 hover:bg-white/20 text-white px-8 py-3.5 rounded-xl font-semibold transition-all border border-white/20 backdrop-blur-sm hover:-translate-y-0.5">
            Compare Tools →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="bg-white border-b border-border -mt-6 relative z-20">
    <div class="max-w-4xl mx-auto px-4">
      <div class="bg-white rounded-2xl shadow-xl border border-border grid grid-cols-3 divide-x divide-border overflow-hidden">
        <a href="/tools/" class="flex flex-col items-center justify-center hover:bg-violet-50 transition-colors py-6 group">
          <p class="text-2xl md:text-3xl font-bold text-primary mono group-hover:scale-105 transition-transform">{publishedTools.length}</p>
          <p class="text-xs text-text-muted mt-1 uppercase tracking-wide font-medium">AI Tools</p>
        </a>
        <a href="/compare/" class="flex flex-col items-center justify-center hover:bg-violet-50 transition-colors py-6 group">
          <p class="text-2xl md:text-3xl font-bold text-primary mono group-hover:scale-105 transition-transform">{comparisons.length}</p>
          <p class="text-xs text-text-muted mt-1 uppercase tracking-wide font-medium">Comparisons</p>
        </a>
        <a href="#categories" class="flex flex-col items-center justify-center hover:bg-violet-50 transition-colors rounded-r-2xl py-6 group">
          <p class="text-2xl md:text-3xl font-bold text-primary mono group-hover:scale-105 transition-transform">{categories.length}</p>
          <p class="text-xs text-text-muted mt-1 uppercase tracking-wide font-medium">Categories</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Search Bar -->
  <section class="py-8 bg-surface">
    <div class="max-w-2xl mx-auto px-4">
      <div class="relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          id="hero-search"
          placeholder='Search — try "GitHub Copilot", "CI/CD", "monitoring"...'
          autocomplete="off"
          class="w-full pl-12 pr-4 py-4 rounded-xl border border-border bg-white text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 shadow-sm transition-all"
        />
        <div id="hero-search-results" class="absolute top-full left-0 right-0 mt-1 bg-white rounded-xl shadow-xl border border-gray-100 z-50 hidden max-h-72 overflow-y-auto text-left">
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section id="categories" class="py-16 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold mb-2">Browse by Category</h2>
        <p class="text-text-muted">Every layer of your DevOps pipeline, covered.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {categories.map((cat) => {
          const toolCount = publishedTools.filter(t => t.category === cat.name).length;
          const cfg = categoryConfig[cat.name] || { color: 'bg-gray-50 text-gray-700', border: 'border-l-gray-300', icon: '📦' };
          return (
            <a href={`/category/${cat.slug}/`} class={`cat-card bg-white rounded-xl p-5 border border-border ${cfg.border} group flex flex-col`}>
              <div class={`w-10 h-10 rounded-lg ${cfg.color} flex items-center justify-center text-xl mb-3 group-hover:scale-110 transition-transform`}>
                {cfg.icon}
              </div>
              <h3 class="font-semibold group-hover:text-primary transition-colors text-sm">{cat.name}</h3>
              <p class="text-xs text-text-muted mt-1 mono">{toolCount} tools</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Recently Added Section -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-2xl font-bold flex items-center gap-3">
          <span class="w-1 h-7 rounded-full bg-gradient-to-b from-primary to-accent block"></span>
          Recently Added
          <span class="inline-flex items-center gap-1.5 text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-100 px-2 py-0.5 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            New
          </span>
        </h2>
        <a href="/tools/" class="text-primary hover:text-primary-dark font-medium text-sm transition-colors">View all →</a>
      </div>
      <p class="text-sm text-text-muted mb-8">The latest AI DevOps tools we've reviewed and added to the index.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentlyAddedTools.map((tool) => (
          <ToolCard
            name={tool.tool_name}
            slug={tool.slug}
            category={tool.category}
            shortDescription={tool.short_description}
            vendor={tool.vendor}
            pricingModel={tool.pricing_model}
            startingPrice={tool.starting_price}
            websiteUrl={tool.website_url}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-secondary text-white relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-20"></div>
    <div class="absolute top-0 right-0 w-64 h-64 bg-primary/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-accent/10 rounded-full blur-3xl"></div>
    <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
      <div class="inline-flex items-center gap-2 bg-white/10 text-xs font-medium text-violet-300 px-3 py-1.5 rounded-full mb-6">
        <span class="mono">{comparisons.length} comparisons available</span>
      </div>
      <h2 class="text-3xl font-bold mb-4">Can't decide? Compare side by side</h2>
      <p class="text-lg text-gray-400 mb-8 max-w-xl mx-auto">
        Detailed breakdowns of the most-searched tool matchups — features, pricing, and who wins where.
      </p>
      <a href="/compare/" class="bg-primary hover:bg-primary-dark text-white px-8 py-3.5 rounded-xl font-semibold transition-all hover:shadow-lg hover:shadow-primary/30 inline-block">
        View Comparisons
      </a>
    </div>
  </section>

  <!-- Latest Guides Section -->
  {latestGuides.length > 0 && (
    <section class="py-16 bg-surface">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-10">
          <h2 class="text-2xl font-bold flex items-center gap-3">
            <span class="w-1 h-7 rounded-full bg-gradient-to-b from-primary to-accent block"></span>
            Latest Guides
          </h2>
          <a href="/blog/" class="text-primary hover:text-primary-dark font-medium text-sm transition-colors">View all →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {latestGuides.map((guide) => (
            <a href={`/blog/${guide.slug}/`} class="card-hover bg-white border border-border rounded-xl p-6 group flex flex-col">
              <div class="flex items-center gap-2 mb-3">
                <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${guide.type === 'best-tools' ? 'bg-primary/10 text-primary' : 'bg-accent/10 text-secondary'}`}>
                  {guide.type === 'best-tools' ? 'Best Tools' : 'How to Choose'}
                </span>
                <span class="text-xs text-text-muted mono">{estimateReadingTime(guide.content)} min</span>
              </div>
              <h3 class="font-semibold text-base group-hover:text-primary transition-colors mb-2 flex-1">{guide.title}</h3>
              <p class="text-sm text-text-muted line-clamp-2 mb-3">{guide.description}</p>
              <p class="text-xs text-text-muted mono">{new Date(guide.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Hero Search Script -->
  <script define:vars={{ toolsData: publishedTools.map(t => ({ name: t.tool_name, slug: t.slug, category: t.category, description: t.short_description, website: t.website_url })) }}>
    const input = document.getElementById('hero-search');
    const resultsBox = document.getElementById('hero-search-results');
    let activeIndex = -1;
    let currentMatches = [];

    function renderResults(matches) {
      currentMatches = matches;
      activeIndex = -1;
      if (matches.length === 0) {
        resultsBox.classList.add('hidden');
        resultsBox.innerHTML = '';
        return;
      }
      resultsBox.innerHTML = matches.map((t, i) => {
        let domain = '';
        try { domain = t.website ? new URL(t.website).hostname : ''; } catch {}
        return `
        <a href="/tools/${t.slug}/" data-index="${i}" class="search-item flex items-center gap-3 px-4 py-3 hover:bg-violet-50 transition-colors border-b border-gray-50 last:border-0">
          <img src="https://www.google.com/s2/favicons?domain=${domain}&sz=32" class="w-6 h-6 rounded" alt="" onerror="this.style.display='none'" />
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900 truncate">${t.name}</p>
            <p class="text-xs text-gray-400">${t.category}</p>
          </div>
          <svg class="w-4 h-4 text-gray-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>`
      }).join('');
      resultsBox.classList.remove('hidden');
    }

    function setActive(index) {
      const items = resultsBox.querySelectorAll('.search-item');
      items.forEach(el => el.classList.remove('bg-violet-50'));
      if (index >= 0 && index < items.length) {
        items[index].classList.add('bg-violet-50');
        items[index].scrollIntoView({ block: 'nearest' });
      }
    }

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (q.length < 2) { resultsBox.classList.add('hidden'); currentMatches = []; activeIndex = -1; return; }
      const matches = toolsData.filter(t =>
        t.name.toLowerCase().includes(q) || t.category.toLowerCase().includes(q) || t.description.toLowerCase().includes(q)
      ).slice(0, 8);
      renderResults(matches);
    });

    input.addEventListener('keydown', (e) => {
      const items = resultsBox.querySelectorAll('.search-item');
      if (e.key === 'ArrowDown') { e.preventDefault(); activeIndex = Math.min(activeIndex + 1, items.length - 1); setActive(activeIndex); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); activeIndex = Math.max(activeIndex - 1, -1); setActive(activeIndex); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIndex >= 0 && currentMatches[activeIndex]) window.location.href = `/tools/${currentMatches[activeIndex].slug}/`;
        else if (input.value.trim()) window.location.href = `/tools/?q=${encodeURIComponent(input.value.trim())}`;
      } else if (e.key === 'Escape') { resultsBox.classList.add('hidden'); activeIndex = -1; }
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target) && !resultsBox.contains(e.target)) { resultsBox.classList.add('hidden'); activeIndex = -1; }
    });
  </script>

  <!-- Suggest Tool Section -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="bg-gradient-to-br from-violet-50 to-cyan-50 border border-violet-100 rounded-2xl p-10">
        <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-2xl mx-auto mb-4">💡</div>
        <h2 class="text-2xl font-bold mb-3">Know a tool we're missing?</h2>
        <p class="text-text-muted mb-6 max-w-md mx-auto">
          We review every submission. If it's a genuine AI DevOps tool, we'll add it.
        </p>
        <a href="/suggest/" class="bg-primary hover:bg-primary-dark text-white px-8 py-3 rounded-xl font-semibold transition-colors inline-block shadow-lg shadow-primary/20">
          Suggest a Tool
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
