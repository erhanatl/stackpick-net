---
import BaseLayout from '../../layouts/BaseLayout.astro';
import tools from '../../data/tools.json';
import comparisons from '../../data/comparisons.json';
import guides from '../../data/guides.json';
import { marked } from 'marked';

export function getStaticPaths() {
  return tools
    .filter(t => t.status === 'Published')
    .map(tool => ({
      params: { slug: tool.slug },
      props: { tool }
    }));
}

const { tool } = Astro.props;

const categorySlug: Record<string, string> = {
  'CI/CD': 'ci-cd',
  'Code Assistant': 'code-assistant',
  'Monitoring': 'monitoring',
  'Testing': 'testing',
  'Security': 'security',
  'IaC': 'iac',
  'AI Code Review': 'ai-code-review',
  'AIOps': 'aiops',
};

const categoryColors: Record<string, string> = {
  'CI/CD': 'bg-blue-100 text-blue-800',
  'Code Assistant': 'bg-purple-100 text-purple-800',
  'Monitoring': 'bg-green-100 text-green-800',
  'Testing': 'bg-orange-100 text-orange-800',
  'Security': 'bg-red-100 text-red-800',
  'IaC': 'bg-cyan-100 text-cyan-800',
  'AI Code Review': 'bg-indigo-100 text-indigo-800',
  'AIOps': 'bg-amber-100 text-amber-800',
};

const pricingColors: Record<string, { bg: string; border: string; text: string; label: string }> = {
  'Free':        { bg: 'bg-green-50',   border: 'border-green-200',  text: 'text-green-700',  label: 'Free' },
  'Freemium':    { bg: 'bg-blue-50',    border: 'border-blue-200',   text: 'text-blue-700',   label: 'Free Tier Available' },
  'Paid':        { bg: 'bg-orange-50',  border: 'border-orange-200', text: 'text-orange-700', label: 'Paid Only' },
  'Enterprise':  { bg: 'bg-purple-50',  border: 'border-purple-200', text: 'text-purple-700', label: 'Enterprise' },
  'Open Source': { bg: 'bg-emerald-50', border: 'border-emerald-200',text: 'text-emerald-700',label: 'Open Source' },
};
const pricingStyle = pricingColors[tool.pricing_model] || { bg: 'bg-gray-50', border: 'border-gray-200', text: 'text-gray-700', label: tool.pricing_model };

// Responsive price font: long strings get smaller text
const priceLen = (tool.starting_price || '').length;
const priceFontClass = priceLen > 20
  ? 'text-sm font-semibold leading-snug'
  : priceLen > 12
    ? 'text-xl font-bold'
    : 'text-3xl font-bold';

const getDomain = (url: string | undefined) => {
  if (!url) return null;
  try { return new URL(url).hostname; } catch { return null; }
};
const toolDomain = getDomain(tool.website_url);
const toolLogo = toolDomain ? `https://www.google.com/s2/favicons?domain=${toolDomain}&sz=64` : null;

const lastUpdated = (tool as any).last_updated
  ? new Date((tool as any).last_updated).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : null;

const allRelatedTools = tools.filter(t => t.category === tool.category && t.slug !== tool.slug && t.status === 'Published');
const relatedTools = [...allRelatedTools].sort((a, b) => a.tool_name.localeCompare(b.tool_name)).slice(0, 4);
const relatedComparisons = comparisons.filter(c => c.tools.includes(tool.slug));

// "Also compare" widget: up to 4 comparison chips shown after Pros & Cons.
// Each chip shows the name(s) of the other tool(s) in the comparison.
const alsoCompare = relatedComparisons.slice(0, 4).map(comp => {
  const otherSlugs = comp.tools.filter((s: string) => s !== tool.slug);
  const otherNames = otherSlugs
    .map((s: string) => tools.find(t => t.slug === s)?.tool_name ?? s)
    .join(' & ');
  return { slug: comp.slug, otherNames };
});
const relatedGuides = guides.filter(g =>
  g.category === tool.category ||
  g.title.toLowerCase().includes(tool.tool_name.toLowerCase()) ||
  g.content.toLowerCase().includes(tool.tool_name.toLowerCase())
).slice(0, 4);

const prosList = tool.pros.split(',').map((p: string) => p.trim());
const consList = tool.cons.split(',').map((c: string) => c.trim());

const faqs = [
  {
    question: `What is ${tool.tool_name}?`,
    answer: tool.short_description
  },
  {
    question: `How much does ${tool.tool_name} cost?`,
    answer: `${tool.tool_name} uses a ${tool.pricing_model.toLowerCase()} pricing model with plans starting at ${tool.starting_price}.`
  },
  {
    question: `What are the main advantages of ${tool.tool_name}?`,
    answer: `The key advantages of ${tool.tool_name} include: ${prosList.join('; ')}.`
  },
  {
    question: `What are the drawbacks of ${tool.tool_name}?`,
    answer: `Some limitations to consider: ${consList.join('; ')}.`
  },
  {
    question: `What category does ${tool.tool_name} belong to?`,
    answer: `${tool.tool_name} is a ${tool.category} tool developed by ${tool.vendor}.`
  }
];
---

<BaseLayout
  title={`${tool.tool_name} Review 2026 | Pricing, Pros & Cons`}
  description={`${tool.tool_name} by ${tool.vendor} — ${tool.short_description} Pricing: ${tool.starting_price} (${tool.pricing_model}).`}
>
  <article class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="text-sm text-text-muted mb-8">
        <a href="/" class="hover:text-primary">Home</a>
        <span class="mx-2">/</span>
        <a href="/tools/" class="hover:text-primary">Tools</a>
        <span class="mx-2">/</span>
        <a href={`/category/${categorySlug[tool.category]}/`} class="hover:text-primary">{tool.category}</a>
        <span class="mx-2">/</span>
        <span class="text-text">{tool.tool_name}</span>
      </nav>

      <!-- Hero Card -->
      <div class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-white to-violet-50 border border-border rounded-2xl p-6 md:p-8 mb-8">
        <!-- Decorative blobs -->
        <div class="absolute -top-16 -right-16 w-56 h-56 bg-primary/5 rounded-full pointer-events-none"></div>
        <div class="absolute -bottom-10 -left-10 w-36 h-36 bg-accent/5 rounded-full pointer-events-none"></div>

        <div class="relative flex flex-col md:flex-row md:items-start gap-6">
          <!-- Left: Logo + identity -->
          <div class="flex items-start gap-4 flex-1 min-w-0">
            {toolLogo ? (
              <img src={toolLogo} alt={`${tool.tool_name} logo`} width="56" height="56"
                class="rounded-xl shrink-0 shadow-sm border border-white" loading="lazy" />
            ) : (
              <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 shadow-sm">
                <span class="text-2xl font-bold text-primary">{tool.tool_name.charAt(0)}</span>
              </div>
            )}
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${categoryColors[tool.category] || 'bg-gray-100 text-gray-700'}`}>
                  {tool.category}
                </span>
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${pricingStyle.bg} ${pricingStyle.border} ${pricingStyle.text}`}>
                  {pricingStyle.label}
                </span>
              </div>
              <h1 class="text-3xl md:text-4xl font-bold leading-tight">{tool.tool_name}</h1>
              <p class="text-text-muted mt-1">by {tool.vendor}</p>
            </div>
          </div>

          <!-- Right: Price + CTAs -->
          <div class="md:shrink-0 md:text-right md:max-w-[200px]">
            <p class="text-xs font-medium text-text-muted uppercase tracking-wider mb-1">Starting at</p>
            <p class={`${priceFontClass} text-secondary`}>{tool.starting_price}</p>
            <div class="flex md:flex-col gap-2 mt-3">
              <a href={tool.affiliate_url || tool.website_url} target="_blank" rel="noopener noreferrer"
                class="bg-primary hover:bg-primary-dark text-white px-5 py-2.5 rounded-lg font-semibold transition-colors text-sm text-center flex-1 md:flex-none">
                Visit Website
              </a>
              <a href={`/pricing/${tool.slug}/`}
                class="bg-white hover:bg-gray-50 text-secondary border border-border px-5 py-2.5 rounded-lg font-semibold transition-colors text-sm text-center flex-1 md:flex-none">
                View Pricing →
              </a>
            </div>
          </div>
        </div>

        <!-- Description -->
        <p class="relative mt-5 pt-5 border-t border-gray-100 text-gray-700 leading-relaxed">{tool.short_description}</p>

        {lastUpdated && (
          <p class="mt-3 text-xs text-text-muted">Last verified: {lastUpdated}</p>
        )}
      </div>

      <!-- Internal Link Bar -->
      <div class="flex flex-wrap gap-2 mb-8">
        <a href={`/pricing/${tool.slug}/`} class="flex items-center gap-1.5 text-sm bg-white border border-border rounded-lg px-3 py-1.5 hover:border-primary hover:text-primary transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Pricing
        </a>
        <a href={`/alternatives/${tool.slug}/`} class="flex items-center gap-1.5 text-sm bg-white border border-border rounded-lg px-3 py-1.5 hover:border-primary hover:text-primary transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
          Alternatives
        </a>
        {relatedComparisons.length > 0 && (
          <a href={`#comparisons`} class="flex items-center gap-1.5 text-sm bg-white border border-border rounded-lg px-3 py-1.5 hover:border-primary hover:text-primary transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            {relatedComparisons.length} Comparison{relatedComparisons.length > 1 ? 's' : ''}
          </a>
        )}
        <a href={`/category/${categorySlug[tool.category]}/`} class="flex items-center gap-1.5 text-sm bg-white border border-border rounded-lg px-3 py-1.5 hover:border-primary hover:text-primary transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
          All {tool.category} Tools
        </a>
      </div>

      {tool.content && (
        <section class="mb-10 prose prose-lg max-w-none" set:html={marked(tool.content)} />
      )}

      <!-- Description (fallback if no AI content) -->
      {!tool.content && (
        <section class="mb-10">
          <h2 class="text-2xl font-bold mb-4">Overview</h2>
          <p class="text-lg leading-relaxed">{tool.short_description}</p>
        </section>
      )}

      <!-- Pros & Cons -->
      <section class="grid md:grid-cols-2 gap-6 mb-10">
        <div class="bg-green-50 rounded-xl p-6">
          <h3 class="text-lg font-bold text-green-800 mb-4">Pros</h3>
          <ul class="space-y-2">
            {tool.pros.split(',').map((pro: string) => (
              <li class="flex items-start gap-2">
                <span class="text-success font-bold mt-0.5">+</span>
                <span>{pro.trim()}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-red-50 rounded-xl p-6">
          <h3 class="text-lg font-bold text-red-800 mb-4">Cons</h3>
          <ul class="space-y-2">
            {tool.cons.split(',').map((con: string) => (
              <li class="flex items-start gap-2">
                <span class="text-danger font-bold mt-0.5">-</span>
                <span>{con.trim()}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Community Intel: Known Issues + Avoid If -->
      {((tool as any).known_issues || (tool as any).avoid_if) && (
        <section class="mb-10 rounded-xl border border-amber-200 bg-amber-50 p-6">
          <div class="flex items-center gap-2 mb-4">
            <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
            </svg>
            <h2 class="text-lg font-bold text-amber-900">What Users Actually Complain About</h2>
          </div>
          {(tool as any).known_issues && (
            <p class="text-amber-800 leading-relaxed mb-4">{(tool as any).known_issues}</p>
          )}
          {(tool as any).avoid_if && (
            <div class="pt-4 border-t border-amber-200">
              <p class="text-sm font-semibold text-amber-900 mb-1">Skip it if:</p>
              <p class="text-amber-800 text-sm leading-relaxed">{(tool as any).avoid_if}</p>
            </div>
          )}
          <p class="text-xs text-amber-600 mt-4">Based on community feedback from Reddit, HN, and G2 reviews.</p>
        </section>
      )}

      <!-- Also Compare Widget -->
      {alsoCompare.length > 0 && (
        <section class="mb-10">
          <h2 class="text-base font-semibold text-text-muted uppercase tracking-wide mb-3">Compare {tool.tool_name} with</h2>
          <div class="flex flex-wrap gap-2">
            {alsoCompare.map(({ slug, otherNames }) => (
              <a
                href={`/compare/${slug}/`}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-border bg-white text-sm font-medium hover:border-primary hover:text-primary transition-colors"
              >
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                </svg>
                {otherNames}
              </a>
            ))}
            {relatedComparisons.length > 4 && (
              <a href="#comparisons" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-dashed border-border text-sm text-text-muted hover:text-primary hover:border-primary transition-colors">
                +{relatedComparisons.length - 4} more
              </a>
            )}
          </div>
        </section>
      )}

      <!-- FAQ Section -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="bg-surface rounded-xl p-5 group">
              <summary class="font-semibold cursor-pointer list-none flex items-center justify-between">
                {faq.question}
                <svg class="w-5 h-5 text-text-muted transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <p class="mt-3 text-text-muted">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Related Comparisons -->
      {relatedComparisons.length > 0 && (
        <section id="comparisons" class="mb-10">
          <h2 class="text-2xl font-bold mb-4">{tool.tool_name} Comparisons</h2>
          <div class="space-y-3">
            {relatedComparisons.map((comp) => (
              <a href={`/compare/${comp.slug}/`} class="flex items-center gap-3 bg-white border border-border rounded-xl p-4 hover:shadow-md transition-shadow group">
                <span class="bg-primary/10 text-primary rounded-lg p-2 shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                </span>
                <div>
                  <h3 class="font-semibold group-hover:text-primary transition-colors">{comp.title}</h3>
                  <p class="text-sm text-text-muted">{comp.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Related Guides -->
      {relatedGuides.length > 0 && (
        <section class="mb-10">
          <h2 class="text-2xl font-bold mb-4">{tool.category} Guides</h2>
          <div class="space-y-3">
            {relatedGuides.map((guide) => (
              <a href={`/blog/${guide.slug}/`} class="flex items-center gap-3 bg-white border border-border rounded-xl p-4 hover:shadow-md transition-shadow group">
                <span class={`rounded-lg p-2 shrink-0 ${guide.type === 'best-tools' ? 'bg-primary/10 text-primary' : 'bg-accent/10 text-secondary'}`}>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                </span>
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="font-semibold group-hover:text-primary transition-colors">{guide.title}</h3>
                    <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${guide.type === 'best-tools' ? 'bg-primary/10 text-primary' : 'bg-accent/10 text-secondary'}`}>
                      {guide.type === 'best-tools' ? 'Best Tools' : 'How to Choose'}
                    </span>
                  </div>
                  <p class="text-sm text-text-muted">{guide.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- CTA -->
      <div class="bg-surface rounded-xl p-8 text-center mb-10">
        <h3 class="text-xl font-bold mb-3">Try {tool.tool_name}</h3>
        <p class="text-text-muted mb-4">Starting at {tool.starting_price}</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href={tool.affiliate_url || tool.website_url}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-primary hover:bg-primary-dark text-white px-8 py-3 rounded-lg font-semibold transition-colors inline-block"
          >
            Visit Website
          </a>
          <a
            href={`/alternatives/${tool.slug}/`}
            class="bg-white hover:bg-gray-50 text-secondary border border-border px-8 py-3 rounded-lg font-semibold transition-colors inline-block"
          >
            View Alternatives
          </a>
        </div>
      </div>

      <!-- Related Tools -->
      {relatedTools.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold">Other {tool.category} Tools</h2>
            {allRelatedTools.length > 4 && (
              <a href={`/category/${categorySlug[tool.category]}/`} class="text-primary hover:text-primary-dark font-medium text-sm">
                View all {allRelatedTools.length} tools &rarr;
              </a>
            )}
          </div>
          <div class="grid md:grid-cols-2 gap-4">
            {relatedTools.map((related) => {
              const domain = related.website_url ? (() => { try { return new URL(related.website_url).hostname; } catch { return null; } })() : null;
              const logoUrl = domain ? `https://www.google.com/s2/favicons?domain=${domain}&sz=64` : null;
              const colorClass = categoryColors[related.category] || 'bg-gray-100 text-gray-800';
              return (
                <a href={`/tools/${related.slug}/`} class="card-hover block bg-white border border-border rounded-xl p-5 group">
                  <div class="flex items-start justify-between mb-3">
                    <div class="flex items-center gap-3">
                      {logoUrl ? (
                        <img src={logoUrl} alt={`${related.tool_name} logo`} width="32" height="32" class="rounded-md shrink-0" loading="lazy" />
                      ) : (
                        <div class="w-8 h-8 rounded-md bg-gray-100 flex items-center justify-center shrink-0">
                          <span class="text-sm font-bold text-gray-400">{related.tool_name.charAt(0)}</span>
                        </div>
                      )}
                      <div>
                        <h4 class="font-semibold group-hover:text-primary transition-colors">{related.tool_name}</h4>
                        <p class="text-xs text-text-muted">{related.vendor}</p>
                      </div>
                    </div>
                    <span class={`text-xs font-medium px-2.5 py-1 rounded-full shrink-0 ml-2 ${colorClass}`}>{related.category}</span>
                  </div>
                  <p class="text-sm text-gray-600 mb-3 line-clamp-2">{related.short_description}</p>
                  <div class="text-sm">
                    <span class="font-medium">{related.starting_price}</span>
                    <span class="text-text-muted"> · {related.pricing_model}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <!-- JSON-LD: SoftwareApplication -->
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": tool.tool_name,
        "description": tool.short_description,
        "applicationCategory": "DeveloperApplication",
        "applicationSubCategory": tool.category,
        "operatingSystem": "Web",
        "url": tool.website_url,
        "provider": {
          "@type": "Organization",
          "name": tool.vendor
        },
        "offers": {
          "@type": "Offer",
          "price": tool.starting_price,
          "priceCurrency": "USD",
          "category": tool.pricing_model
        }
      })} />

      <!-- JSON-LD: FAQPage -->
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map(faq => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }))
      })} />

      <!-- JSON-LD: BreadcrumbList -->
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://stackpick.net/" },
          { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://stackpick.net/tools/" },
